{
	"file_scan_exclusions": [
		"**/build/**",
		"**/dist/**",
		"**/.cache/**",
		"**/.claude/**",
		"**/.git/**",
		".editorconfig",
		".gitattributes",
		".gitmodules",
		".cloc-ignore",
		"**.log",
		"**.pcap"
	],
	"lsp": {
		"clangd": {
			// Omit "binary" entirely to let the extension manage clangd, or pin one:
			// "binary": { "path": "C:/Program Files/LLVM/bin/clangd.exe" },
			"binary": {
				"path": "C:/msys64/ucrt64/bin/clangd.exe",
				"arguments": [
					"--background-index",
					"--clang-tidy",
					"--header-insertion=never",
					"--completion-style=detailed",
					"--pch-storage=memory",
					"-j=8",
				],
			},
		},
	},
	"file_types": {
		"C": ["C", "H", "c", "h"],
	},
}
